# =============================================================
# Alarme de Preços: configuração
# Copie para .env (cp .env.example .env) e preencha.
# O .env é relido a cada busca: trocar a chave NÃO exige mexer
# no código nem reiniciar o app.
# =============================================================

# --- SerpApi (Google Flights) --------------------------------
# Crie a conta em https://serpapi.com e copie a chave em
# https://serpapi.com/manage-api-key
# Sem chave, o app roda em MODO DEMONSTRAÇÃO (preços fictícios).
# Ao contratar um plano pago, basta trocar o valor abaixo.
SERPAPI_API_KEY=

# Buscas/mês do plano gratuito (usado para identificar o plano Free no painel)
SERPAPI_FREE_PLAN_SEARCHES=250
# Trava local de buscas reais por hora (plano Free: 50/h)
SERPAPI_HOURLY_LIMIT=50

# --- Busca ---------------------------------------------------
ALARME_CURRENCY=BRL
ALARME_LANGUAGE=pt
ALARME_COUNTRY=br
# Tempo (min) em que a mesma rota+data reaproveita o resultado sem gastar cota
ALARME_CACHE_TTL_MINUTES=60
# Intervalo padrão dos monitores (horas). 6 h = ~120 buscas/mês por rota
ALARME_MONITOR_INTERVAL_HOURS=6
# Banco SQLite (padrão: ./data/alarme_precos.db)
# ALARME_DB_PATH=

# --- Servidor web --------------------------------------------
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
# Link público *.gradio.live. Só ligue com APP_AUTH_* preenchidos.
GRADIO_SHARE=false
APP_AUTH_USER=
APP_AUTH_PASSWORD=
